# Copy to .env and replace every "change_me" value. Never commit .env.
APP_ENV=development
APP_DEBUG=true
# Public URL of the frontend (used in password-reset emails)
APP_URL=http://localhost:5173

DB_HOST=db
DB_PORT=3306
DB_NAME=library
DB_USER=library
DB_PASS=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password
DB_TEST_NAME=library_test

# At least 32 random characters each, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_token_secret_min_32_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Comma-separated allowlist of browser origins
CORS_ORIGIN=http://localhost:5173
# Trust X-Forwarded-For from a reverse proxy (needed behind the Vite proxy / a load balancer)
TRUST_PROXY=false

# Circulation rules (defaults; admins can override them in Settings)
FINE_PER_DAY=5
MAX_BOOKS_PER_STUDENT=5
LOAN_DAYS=14
MAX_RENEWALS=3
RESERVATION_HOLD_HOURS=48
LOST_BOOK_FEE=500

# SMTP (Docker uses the bundled Mailpit catcher at http://localhost:8025). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# tls | ssl | empty
SMTP_SECURE=
MAIL_FROM=library@library.test
MAIL_FROM_NAME=Library Management System
